# SOLFLOW — MAINNET LAUNCH ENVIRONMENT TEMPLATE
# Copy to .env.local on launch day and fill in the marked values.
# Public wallet addresses are fine here; NEVER put private keys or seed
# phrases in this file. Server-side secrets (JUPITER_API_KEY, ALCHEMY_API_KEY,
# ADMIN_WALLET) are injected as Vercel Secrets, not NEXT_PUBLIC_*.

# ---- network / mode (launch-day values) ----
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_DEMO_MODE=false

# ---- program + token mints ----
NEXT_PUBLIC_PROGRAM_ID=DzWRKvCg5xZuaYSb1W2Dau4UUWPqGUohWWAxheMnuQyQ
NEXT_PUBLIC_FLOW_MINT=<SET-ON-LAUNCH-DAY official $FLOW mint>
NEXT_PUBLIC_NVDA_MINT=Xsc9qvGR1efVDFGLrVsmkzv3qi45LTBjeUKSPmx9qEh

# ---- wallet roles (public addresses only) ----
NEXT_PUBLIC_CREATOR_FEE_SOURCE=GPsLKasHcWib1dpSZNcitxaXfdLSDCJEE73qZ8qY4DRS
NEXT_PUBLIC_CREATOR_PAYOUT=GPsLKasHcWib1dpSZNcitxaXfdLSDCJEE73qZ8qY4DRS
NEXT_PUBLIC_TREASURY=8VAgZxVDaKW9hoGYnyQDKpkgGXmMXEZWUwVmCWHVdCGv

# ---- reward economics (do not change) ----
NEXT_PUBLIC_SOL_REWARD_ALLOCATION_BPS=7000
NEXT_PUBLIC_NVDA_REWARD_ALLOCATION_BPS=3000
PROTOCOL_FEE_BPS=0

# ---- SOL -> NVDAx conversion ----
NEXT_PUBLIC_NVDA_SWAP_ADAPTER=jupiter-swap-v2

# ---- server-side secrets (injected as Vercel Secrets; never NEXT_PUBLIC_) ----
# JUPITER_API_KEY=<existing key from the operator's Jupiter portal>
# ALCHEMY_API_KEY=<existing key>
# ADMIN_WALLET=<operator wallet public key — already configured in Vercel prod>

# ---- MAINNET STAGING ($TST) — separate program, operator-activated ----
# The staging program is a SEPARATE deployment with its own keypair/ID
# (never the production program):
#   NEXT_PUBLIC_STAGING_PROGRAM_ID=s4VqR5ayvD3PALEiBFTdMBEdy6beN9YtNesG3BsBBFW
#   NEXT_PUBLIC_STAKING_TEST_MODE=true
#   NEXT_PUBLIC_DEMO_MODE=false
#   NEXT_PUBLIC_FLOW_MINT=<TST_MAINNET_MINT>   (staging token $TST)
# Production must keep:
#   NEXT_PUBLIC_STAGING_PROGRAM_ID=
#   NEXT_PUBLIC_STAKING_TEST_MODE=false
#   NEXT_PUBLIC_FLOW_MINT=<REAL_FLOW_MINT_LATER>
