# ─────────────────────────────────────────────────────────────
# SOLFLOW — example environment file
# Copy to .env.local and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Public (safe for the browser) ────────────────────────────
# Solana cluster: "mainnet-beta" | "devnet" | "testnet"
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Public RPC endpoint (leave empty to use the cluster default public endpoint).
# For Alchemy RPC configure ALCHEMY_SOLANA_RPC_URL server-side (see below).
NEXT_PUBLIC_SOLANA_RPC_URL=
# When "true" the app runs the clearly-labeled simulation. Keep "true" until
# ALL infrastructure below is configured AND passes /api/infrastructure checks.
NEXT_PUBLIC_DEMO_MODE=true

# Deployed SOLFLOW staking/reward program. Keep empty until a real program
# is deployed. The app reports NOT DEPLOYED and stays in demo until then.
NEXT_PUBLIC_PROGRAM_ID=

# Watched creator-fee source wallet(s) — comma-separated public addresses.
# Inflows are counted as creator fees ONLY from these sources into the vault.
NEXT_PUBLIC_CREATOR_FEE_SOURCE=
NEXT_PUBLIC_CREATOR_FEE_SOURCES=

# SOL reward vault that receives creator fees (public address, not a secret)
NEXT_PUBLIC_SOL_REWARD_VAULT=

# NVDA reward token — operator MUST supply the REAL SPL mint.
# The app never invents this address; empty = "NVDA token unavailable".
NEXT_PUBLIC_NVDA_MINT=
# ATA/associated vault holding NVDA for distribution
NEXT_PUBLIC_NVDA_REWARD_VAULT=

# Reward allocation split (basis points, 0-10000)
NEXT_PUBLIC_SOL_REWARD_ALLOCATION_BPS=
NEXT_PUBLIC_NVDA_REWARD_ALLOCATION_BPS=

# Legacy/optional treasury alias (used as fallback by transparency page)
NEXT_PUBLIC_REWARD_TREASURY=

# ── Server-side only (never prefix with NEXT_PUBLIC_) ────────
# Alchemy API key — server side only. Used by /api routes for standard
# Solana RPC (getSlot, getBalance, getAccountInfo, getProgramAccounts,
# getSignaturesForAddress, getTransaction, getTokenAccountsByOwner,
# getTokenAccountBalance, getTokenSupply). Never expose via NEXT_PUBLIC_*.
ALCHEMY_API_KEY=
# Alchemy Solana RPC (overrides the endpoint built from ALCHEMY_API_KEY).
# Production example shape: https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ALCHEMY_SOLANA_RPC_URL=
# Alchemy Solana WebSocket endpoint for real-time monitoring (prepared, not active).
# Shape: wss://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ALCHEMY_SOLANA_WS_URL=
SERVER_PROGRAM_ID=
# Wallet allowed to view /admin data (server-side authorization)
ADMIN_WALLET=
